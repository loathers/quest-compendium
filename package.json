{
  "name": "quest-compendium",
  "version": "0.0.0",
  "description": "quest-compendium is a Typescript library that intends to provide grimoire tasks for automating KoLmafia",
  "repository": "https://github.com/loathers/quest-compedium.git",
  "main": "dist/scripts/quest-compedium/queso.js",
  "author": "Joe Kirchoff <Kirchoff.Joseph.P@gmail.com>",
  "homepage": "",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --failAfterWarnings",
    "lint": "eslint src --ext .ts && NODE_OPTIONS=\"--experimental-strip-types\" prettier --check .",
    "format": "eslint src --fix --ext .ts && NODE_OPTIONS=\"--experimental-strip-types\" prettier --write .",
    "watch": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --watch --failAfterWarnings",
    "install-mafia": "create-kolmafia-script --install"
  },
  "dependencies": {
    "grimoire-kolmafia": "^0.3.33",
    "kolmafia": "^5.29026.0",
    "libram": "^0.11.22"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/node": "^26.0.0",
    "create-kolmafia-script": "^0.4.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-libram": "^0.6.0",
    "prettier": "^3.8.3",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "packageManager": "yarn@4.12.0"
}
